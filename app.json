{
  "expo": {
    "name": "Kiri",
    "slug": "Kiri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appkiri",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4685F6",
        "foregroundImage": "./assets/images/icon-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.app_kiri"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-ps.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#4F8EF7"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6879d453-e21e-4a92-a225-bd1889b8aafe"
      }
    },
    "owner": "kiristeam"
  }
}
